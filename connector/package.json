{
  "name": "patent-connector",
  "version": "1.4.0",
  "description": "MCP server for the USPTO Open Data Portal: search patents, read claims, abstracts and specifications, and view drawings with your own API key.",
  "main": "index.js",
  "bin": {
    "patent-connector": "index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "manifest.json",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kevin Ringler",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "pack": "npx -y @anthropic-ai/mcpb pack . ../patent-connector-1.4.0.mcpb",
    "test:security": "node test/security.mjs",
    "test:retry": "node test/retry.mjs",
    "test:features": "node test/features.mjs",
    "test:offline": "node test/security.mjs && node test/retry.mjs && node test/features.mjs",
    "check:start": "node scripts/check-bundle.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
